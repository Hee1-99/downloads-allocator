{
  "manifest_version": 3,
  "name": "Subject Folder Downloader",
  "description": "Route course page downloads into matching subject folders inside Downloads.",
  "version": "0.1.0",
  "permissions": ["activeTab", "downloads", "storage", "tabs"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subject Folder Downloader"
  },
  "background": {
    "service_worker": "background.js"
  }
}
